def print_capacity_info(self) -> None:
    """Print current zone/connection capacity usage for this turn."""
    print(f"--- Turn {self.current_turn} capacity ---")
    for zone, count in self.zone_occupancy.items():
        if count > 0:
            print(f"Zone {zone.name}: {count}/{zone.max_drones} drones")
    for connection, count in self.connection_occupancy.items():
        if count > 0:
            print(f"Connection {connection.name}: "
                  f"{count}/{connection.max_link_capacity} capacity used")


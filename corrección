def run(self, capacity_info: bool = False) -> None:
    """Run the simulation turn by turn until all drones are delivered."""
    while len(self.delivered) < len(self.drones):
        self.current_turn += 1
        if self.current_turn > 1000:
            raise ValueError("Simulation did not converge within 1000 turns")
        self.release_connections()
        self.run_turn()
        self.complete_transits()

        if capacity_info:
            self.print_capacity_info()

